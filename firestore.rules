rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // FitTrack temporário: exatamente uma conta de aluno e uma de personal.
    function isAluno() {
      return request.auth != null &&
        request.auth.uid == 'zNaIbAITDNf0YmKQcjHQrNAgSMm1';
    }

    function isPersonal() {
      return request.auth != null &&
        request.auth.uid == 'AUMa1SpruddoMdIOyTKIwkf2qBH3';
    }

    // Não é permitido ler dados de outros UIDs, mesmo com um código copiado.
    match /artifacts/fittrack-pro-app/public/data/plans/{studentUid} {
      allow get: if studentUid == 'zNaIbAITDNf0YmKQcjHQrNAgSMm1' &&
        (isAluno() || isPersonal());
      allow list: if false;
      allow create, update: if studentUid == 'zNaIbAITDNf0YmKQcjHQrNAgSMm1' &&
        isPersonal();
      allow delete: if false;
    }

    // O aluno registra sua evolução; o personal autorizado consulta.
    match /artifacts/fittrack-pro-app/public/data/studentLogs/{studentUid}/days/{day} {
      allow get: if studentUid == 'zNaIbAITDNf0YmKQcjHQrNAgSMm1' &&
        (isAluno() || isPersonal());
      allow list: if false;
      allow create, update: if studentUid == 'zNaIbAITDNf0YmKQcjHQrNAgSMm1' &&
        isAluno();
      allow delete: if false;
    }

    // Permitir somente a migração do diário antigo do próprio aluno.
    match /artifacts/fittrack-pro-app/public/data/logs/{logId} {
      allow get: if isAluno() &&
        logId.matches('^zNaIbAITDNf0YmKQcjHQrNAgSMm1_[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow list, create, update, delete: if false;
    }

    // Sem autorização genérica via grants, nem acesso às demais coleções.
  }
}
