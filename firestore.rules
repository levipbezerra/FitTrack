rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function studentOrTrainer(studentUid) {
      return signedIn() && (request.auth.uid == studentUid ||
        exists(/databases/$(database)/documents/artifacts/fittrack-pro-app/public/data/grants/$(studentUid)/trainers/$(request.auth.uid)));
    }
    match /artifacts/fittrack-pro-app/public/data/grants/{studentUid}/trainers/{trainerUid} {
      allow get: if signedIn() && (request.auth.uid == studentUid || request.auth.uid == trainerUid);
      allow list: if signedIn() && request.auth.uid == studentUid;
      allow create, update: if signedIn() && request.auth.uid == studentUid &&
        request.resource.data.keys().hasOnly(['studentUid', 'trainerUid']) &&
        request.resource.data.studentUid == studentUid &&
        request.resource.data.trainerUid == trainerUid;
      allow delete: if signedIn() && request.auth.uid == studentUid;
    }
    match /artifacts/fittrack-pro-app/public/data/plans/{studentUid} {
      allow read: if studentOrTrainer(studentUid);
      allow create, update: if studentOrTrainer(studentUid);
      allow delete: if signedIn() && request.auth.uid == studentUid;
    }
    match /artifacts/fittrack-pro-app/public/data/studentLogs/{studentUid}/days/{day} {
      allow read: if studentOrTrainer(studentUid);
      allow create, update, delete: if signedIn() && request.auth.uid == studentUid;
    }
    // Read-only legacy daily logs to support migration for the owning student.
    match /artifacts/fittrack-pro-app/public/data/logs/{logId} {
      allow get: if signedIn() &&
        logId.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow list, create, update, delete: if false;
    }
  }
}
